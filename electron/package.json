{
  "name": "mdviewer-desktop",
  "version": "1.0.0",
  "description": "Standalone macOS app wrapper for mdviewer",
  "author": "George Karypis",
  "main": "main.js",
  "scripts": {
    "sync": "node ../tools/build.js && cp ../mdviewer.html ./mdviewer.html",
    "start": "npm run sync && electron .",
    "selftest": "npm run sync && MDVIEWER_SELFTEST=1 electron .",
    "dist": "npm run sync && electron-builder --config.directories.output=\"${MDVIEWER_OUT:-dist}\""
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "net.karypis.mdviewer",
    "productName": "mdviewer",
    "afterPack": "build/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "mdviewer.html",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown",
          "role": "Editor",
          "rank": "Owner",
          "isPackage": false
        },
        {
          "ext": "markdown",
          "name": "Markdown",
          "role": "Editor",
          "rank": "Owner",
          "isPackage": false
        }
      ]
    },
    "dmg": {
      "title": "mdviewer ${version}"
    }
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
